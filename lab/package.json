{
  "name": "agent-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "从零手写 Agent —— 学习产出集合",
  "scripts": {
    "check": "node check-setup.mjs",
    "mock": "node toolkit/mock-server.mjs",
    "premock": "node scripts/free-mock-port.mjs",
    "demo:naive": "node toolkit/demos/naive-parser-demo.mjs",
    "ex:stream": "node run.mjs exercises/01-raw-api/stream.ts",
    "ex:tools": "node run.mjs exercises/01-raw-api/tools.ts",
    "ex:stream:mock": "node run.mjs exercises/01-raw-api/stream.ts --mock",
    "ex:tools:mock": "node run.mjs exercises/01-raw-api/tools.ts --mock",
    "api:basic": "node run.mjs toolkit/reference/01-basic.ts",
    "api:stream": "node run.mjs toolkit/reference/02-stream.ts",
    "api:tools": "node run.mjs toolkit/reference/03-tools.ts",
    "api:basic:mock": "node run.mjs toolkit/reference/01-basic.ts --mock",
    "api:stream:mock": "node run.mjs toolkit/reference/02-stream.ts --mock",
    "api:tools:mock": "node run.mjs toolkit/reference/03-tools.ts --mock",
    "probe": "cd toolkit/cordis-probe && node probe.mjs",
    "probe:silent-fail": "cd toolkit/cordis-probe && cp case-e-silent-fail.yml cordis.yml && node probe.mjs",
    "probe:service": "cd toolkit/cordis-probe && cp case-f-service-inject.yml cordis.yml && node probe.mjs",
    "probe:no-apply": "cd toolkit/cordis-probe && cp case-g-class-without-apply.yml cordis.yml && node probe.mjs",
    "plugin:dump": "dsh --profile web --patch ./starters/dsh-plugin-starter/cordis.local.yml --dump-config",
    "plugin:web": "dsh web --patch ./starters/dsh-plugin-starter/cordis.local.yml",
    "dsh:help": "dsh --help",
    "typecheck": "tsc --noEmit",
    "doctor": "node scripts/doctor.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.5",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
