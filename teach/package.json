    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "playwright": "^1.64.0",
    "rehype-pretty-code": "^0.14.1",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
